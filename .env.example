# Copy to .env (docker compose reads it automatically).

# Shared by both services — they validate the same tokens. Use a long random string.
JWT_SECRET=change-me-in-production-to-a-long-random-string
POSTGRES_PASSWORD=lattice_dev_pw

# The only account created on first start (Lattice ships empty). Change the password at once.
BOOTSTRAP_ADMIN_EMAIL=admin@lattice.io
BOOTSTRAP_ADMIN_PASSWORD=admin1234

MAX_UPLOAD_MB=50
SMTP_FROM=lattice@lattice.io

# ── Local development without Docker (each service reads these) ──
# DATABASE_URL=sqlite:///./lattice_core.sqlite3
# NOTIFY_DATABASE_URL=sqlite:///./lattice_notify.sqlite3
# REDIS_URL=redis://localhost:6379/0      # empty = no event bus
# SMTP_HOST=localhost                     # empty = log emails instead of sending
